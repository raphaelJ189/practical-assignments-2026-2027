<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE students [

    <!-- Define the root element -->
    <!ELEMENT students (student+)>

    <!-- Define the student structure and element order -->
    <!ELEMENT student (
        firstName,
        lastName,
        gender,
        programme,
        yearOfStudy,
        email,
        phone,
        courses
    )>

    <!-- Define student registration number attribute -->
    <!ATTLIST student regNumber ID #REQUIRED>

    <!-- Define student information elements -->
    <!ELEMENT firstName (#PCDATA)>
    <!ELEMENT lastName (#PCDATA)>
    <!ELEMENT gender (#PCDATA)>
    <!ELEMENT programme (#PCDATA)>
    <!ELEMENT yearOfStudy (#PCDATA)>
    <!ELEMENT email (#PCDATA)>
    <!ELEMENT phone (#PCDATA)>

    <!-- Define courses structure -->
    <!ELEMENT courses (course, course, course+)>

    <!-- Define individual course -->
    <!ELEMENT course (#PCDATA)>

    <!-- Define course code attribute -->
    <!ATTLIST course code CDATA #REQUIRED>

]>

